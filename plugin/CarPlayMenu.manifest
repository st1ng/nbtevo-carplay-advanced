<?xml version="1.0" encoding="utf-8"?>
<plugin>
	<name>CarPlayMenu</name>
	<type>App</type>
	<file>{pluginDir}/CarPlayMenu</file>
	<config>
		<autoStart>yes</autoStart>
		<dependencies>
			<pluginAppConnector>
				<type>Etch</type>
				<id>201</id>
				<asyncCallbacks>yes</asyncCallbacks>
			</pluginAppConnector>
		</dependencies>
		<parameters>
			<DescFile>{pluginDir}/CarPlayMenu.xml</DescFile>
			<TextDBFile>{pluginDir}/CarPlayMenu_ALL_Texts.zip</TextDBFile>
		</parameters>
	</config>
</plugin>
